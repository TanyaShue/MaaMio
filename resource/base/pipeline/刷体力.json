        "timeout": 60000,
        "next": ["刷体力-回家"]
    },
    "刷体力-回家-关卡": {
        "recognition": "TemplateMatch",
        "roi": [
            460,
            515,
            245,
            245
        ],
        "template": ["刷体力/刷体力-完全探索_1.png"],
        "threshold": 0.7,
        // 关卡详情左下「离开」→ 探险地图。用固定坐标：
