{
    // 「刷体力」：确认在莉莉托斯 → 探险 → 1-9 → 完全探索 → 反复扫荡到体力不足 → 回培育室。
    //
    // 停条件写在结构里：循环每轮先用 OCR 读顶栏「当前体力/上限」，只有在 `>= 消耗(16)`
    // 时才点「扫荡」。因此「体力不足」分支永远不会去点扫荡，也就不可能触发任何
    // 「购买/恢复体力」弹窗——红线是构造上避开的，不是事后补救的。
    //
    // 两个已知的界面尺寸陷阱（都实测过）：
    //   * 弹窗（战斗胜利/获得物品）盖住整屏，但被盖住的按钮识别照样成功
    //     （关卡详情标题在弹窗下仍得 0.9967），所以弹窗节点必须排在 next 前面。
    //   * 关卡详情页在弹窗下也能认出「完全探索」，所以弹窗优先同样必要。
    "刷体力-开始": {
        "recognition": "DirectHit",
        // 入口只负责把控制权交给派发器；超时给足以覆盖传送/切场景动画。
        "timeout": 300000,
        "next": ["刷体力-去关卡"]
    },

    // ------------------------------------------------------------------
    // 去关卡：按当前界面选一条路走到「1-9 关卡详情」，走一步回派发器重新判断。
    // ------------------------------------------------------------------
    "刷体力-去关卡": {
        "recognition": "DirectHit",
        "timeout": 300000,
        "next": [
            // 体力本来就不够（<=15）：不必真跑到关卡页，直接回家。
            "刷体力-体力早退",
            "刷体力-去关卡-完全探索",
            "刷体力-去关卡-探险地图",
            "刷体力-去关卡-城市地图",
            "刷体力-去关卡-世界地图",
            "刷体力-去关卡-主界面",
            "刷体力-去关卡-培育室"
        ]
    },
    "刷体力-体力早退": {
        "recognition": "OCR",
        // 顶栏体力：面包图标右侧的「527/540」，短边 720 设计分辨率坐标。
        "roi": [
            338,
            5,
            120,
            32
        ],
        "expected": "^(0|[1-9]|1[0-5])/",
        "threshold": 0.3,
        "action": "DoNothing",
        "timeout": 60000,
        "next": ["刷体力-回家"]
    },
    "刷体力-去关卡-完全探索": {
        "recognition": "TemplateMatch",
        "roi": [
            460,
            515,
            245,
            245
        ],
        "template": ["刷体力/刷体力-完全探索_1.png"],
        "threshold": 0.7,
        // 已经在 1-9 详情页：点「完全探索」选中它（选中标记是它头顶的橙色下箭头）。
        // 已选中时再点一次是幂等的。
        "action": "Click",
        "post_delay": 1200,
        "timeout": 60000,
        "next": ["刷体力-回循环"]
    },
    "刷体力-去关卡-探险地图": {
        "recognition": "TemplateMatch",
        "roi": [
            0,
            1180,
            260,
            100
        ],
        "template": ["刷体力/刷体力-回程_1.png"],
        "threshold": 0.7,
        // 用左下角「回程」按钮认探险地图：「莉莉托斯地区」标题会误命中城市地图
        // 的标题条（实测 0.8312），已弃用。
        // 认到之后点的是 1-9 关卡旗（555,490），不是回程。
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    555,
                    490
                ]
            }
        },
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-确认关卡1-9"]
    },
    "刷体力-确认关卡1-9": {
        "recognition": "TemplateMatch",
        "roi": [
            10,
            140,
            330,
            75
        ],
        "template": ["刷体力/刷体力-关卡详情_1.png"],
        "threshold": 0.9,
        // 标题条写着「莉莉托斯矿洞 1-9」才算真的进了 1-9。
        "action": "DoNothing",
        "timeout": 60000,
        "next": ["刷体力-去关卡"],
        // 点了旗子却没进 1-9 详情（点歪/关卡未解锁）→ 直接回家，绝不瞎点别处。
        "on_error": ["刷体力-回家"]
    },
    "刷体力-去关卡-城市地图": {
        "recognition": "TemplateMatch",
        "roi": [
            340,
            770,
            270,
            230
        ],
        "template": ["刷体力/刷体力-城市地图_1.png"],
        "threshold": 0.7,
        // 城市地图（左上角题头写区域名）：「大地图」图标是稳定锚点。
        "action": "DoNothing",
        "timeout": 60000,
        "next": [
            "刷体力-区域莉莉托斯",
            "刷体力-区域需切换"
        ]
    },
    "刷体力-区域莉莉托斯": {
        "recognition": "OCR",
        // 城市地图题头「莉莉托斯」「阿格莱恩独立王国首都」。
        "roi": [
            22,
            150,
            145,
            42
        ],
        "expected": "莉",
        "threshold": 0.3,
        // 确认在本区，点右下角「探险」。
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    552,
                    1245
                ]
            }
        },
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-去关卡"]
    },
    "刷体力-区域需切换": {
        "max_hit": 1,
        "recognition": "OCR",
        "roi": [
            22,
            150,
            145,
            42
        ],
        "expected": "莉",
        "threshold": 0.3,
        // 不在莉莉托斯：去「大地图」切到「王城莉莉托斯」。
        // max_hit=1：只切一次，避免 OCR 读不到时两地来回弹跳。
        "inverse": true,
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    477,
                    885
                ]
            }
        },
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-去关卡"]
    },
    "刷体力-去关卡-世界地图": {
        "recognition": "TemplateMatch",
        "roi": [
            5,
            140,
            310,
            145
        ],
        "template": ["刷体力/刷体力-世界地图_1.png"],
        "threshold": 0.7,
        // 大地图上点「王城莉莉托斯」标签 → 回到该区域的城市地图。
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    347,
                    478
                ]
            }
        },
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-去关卡"]
    },
    "刷体力-去关卡-主界面": {
        "recognition": "TemplateMatch",
        "roi": [
            440,
            1150,
            280,
            130
        ],
        "template": ["刷体力/刷体力-主界面_1.png"],
        "threshold": 0.7,
        // 主界面右下「出门」→ 城市地图。默认 target 就是识别到的框中心。
        "action": "Click",
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-去关卡"]
    },
    "刷体力-去关卡-培育室": {
        "recognition": "TemplateMatch",
        "roi": [
            120,
            1105,
            220,
            200
        ],
        "template": ["刷体力/刷体力-培育室_1.png"],
        "threshold": 0.7,
        // 模板本身是培育室的「收取」按钮——绝不能点它（会收蛋）。
        // 这里显式把目标改到右下角「农场」（实测 (600,1235) 回主界面）。
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    600,
                    1235
                ]
            }
        },
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-去关卡"]
    },

    // ------------------------------------------------------------------
    // 扫荡循环：体力够就扫一次，扫完关两层全屏弹窗，回来再判体力。
    // ------------------------------------------------------------------
    "刷体力-循环": {
        "recognition": "OCR",
        "roi": [
            338,
            5,
            120,
            32
        ],
        // 当前体力 >= 16（完全探索 1-9 的消耗）才继续扫。
        "expected": "^(1[6-9]|[2-9][0-9]|[0-9]{3,})/",
        "threshold": 0.3,
        "action": "DoNothing",
        "timeout": 120000,
        "next": [
            // 上一次的「获得物品」没关干净时先补关一次，跳回来重新判体力。
            "[JumpBack]刷体力-补关弹窗",
            "刷体力-点扫荡",
            "刷体力-体力不足",
            // OCR 偶发读空（没读到「数字+斜杠」）：算第三种状态，重判一轮。
            "刷体力-体力读不到"
        ],
        // 连读 3 轮都读不出来 → 体力状态不明，按最保守的处理：回家，绝不猜着点扫荡。
        "on_error": ["刷体力-回家"]
    },
    "刷体力-体力读不到": {
        // 最多补判 3 次，避免 OCR 一直读不出来时死循环在这里。
        "max_hit": 3,
        "recognition": "OCR",
        "roi": [
            338,
            5,
            120,
            32
        ],
        // 只要读到了「数字+斜杠」就算读到了；inverse 让这个节点只在读空时命中。
        "expected": "^[0-9]+/",
        "threshold": 0.3,
        "inverse": true,
        "action": "DoNothing",
        "timeout": 30000,
        "next": ["刷体力-回循环"]
    },
    "刷体力-补关弹窗": {
        // 上限兜底：万一还是关不掉，最多自旋 10 轮（约 15s）就把这个候选禁用，
        // 让流程继续往前走，而不是永远转圈。
        "max_hit": 10,
        "recognition": "TemplateMatch",
        "roi": [
            150,
            800,
            420,
            110
        ],
        "template": ["刷体力/刷体力-触摸继续_1.png"],
        // 认「触·摸·继·续」本身，点它的框中心 —— 这才是弹窗的"点击继续"判定区。
        // 之前这里认的是「获得物品」横幅、点的是横幅中心 (365,375)，那是装饰，
        // 点它弹窗不关 → JumpBack 无限自旋 19 分钟。横幅不能当点击目标。
        "threshold": 0.8,
        "action": "Click",
        "post_delay": 1200
    },
    "刷体力-点扫荡": {
        "recognition": "TemplateMatch",
        "roi": [
            270,
            1150,
            175,
            110
        ],
        "template": ["刷体力/刷体力-扫荡_1.png"],
        "threshold": 0.7,
        "action": "Click",
        // 扫荡 → 战斗动画 → 可能中途插「事件」弹窗 → 最后「战斗胜利」/「获得物品」全屏弹窗。
        "post_delay": 2500,
        "timeout": 60000,
        "next": ["刷体力-等战斗结束"]
    },

    // 等战斗结束：扫荡点下去之后到底会出现什么是不确定的——
    //   * 正常：战斗动画 → 「战斗胜利」全屏弹窗（点掉）→ 「获得物品」全屏弹窗（点掉）
    //   * 实测遇到的：战斗中随机插一个「事件」弹窗（⚠事件 + 说明 + 确定），
    //     它不走完战斗就永远卡住，战斗胜利不会来（第一次整跑就是死在这里）。
    // 所以这里做成一个轮询派发器：弹窗优先，其次等结算。
    "刷体力-等战斗结束": {
        "recognition": "DirectHit",
        // 单次等待上限；每关掉一个事件弹窗都会重新进这个节点，计时重置。
        "timeout": 120000,
        "next": [
            "刷体力-事件",
            "刷体力-战斗胜利",
            "刷体力-获得物品"
        ],
        // 120s 还没等到任何结算（战斗失败 / 认不出来的对话框）→ 回家。
        // 真被未知弹窗挡住时「回家」也会认不出界面而超时失败——这是刻意要的「响亮地停」。
        "on_error": ["刷体力-回家"]
    },
    "刷体力-事件": {
        "recognition": "TemplateMatch",
        "roi": [
            110,
            275,
            240,
            85
        ],
        "template": ["刷体力/刷体力-事件_1.png"],
        "threshold": 0.7,
        // 「事件」标题横幅本身不是按钮，只用来判定"现在挂着一个事件弹窗"。
        "action": "DoNothing",
        "timeout": 20000,
        "next": ["刷体力-事件确定"],
        // 横幅自己消失了（事件已自动结束）→ 回去继续等结算。
        "on_error": ["刷体力-等战斗结束"]
    },
    "刷体力-事件确定": {
        "recognition": "TemplateMatch",
        // 在弹窗下半部找「确定」按钮：这样即使弹窗文字行数变化把按钮顶下去也能找到。
        "roi": [
            100,
            600,
            520,
            480
        ],
        "template": ["刷体力/刷体力-确定_1.png"],
        "threshold": 0.7,
        "action": "Click",
        "post_delay": 1500,
        "timeout": 20000,
        "next": ["刷体力-等战斗结束"],
        // 认出了事件弹窗却找不到「确定」（不是单按钮的剧情事件）→ 不猜，直接回家。
        // 被弹窗挡住时「回家」会认不出界面而超时失败，比瞎点安全。
        "on_error": ["刷体力-回家"]
    },
    "刷体力-战斗胜利": {
        "max_hit": 40,
        "recognition": "TemplateMatch",
        "roi": [
            160,
            530,
            420,
            180
        ],
        "template": ["刷体力/刷体力-战斗胜利_1.png"],
        "threshold": 0.7,
        // 全屏弹窗，「触·摸·继·续」点哪都行。
        "action": "Click",
        "post_delay": 1500,
        "timeout": 30000,
        "next": ["刷体力-获得物品"],
        // 这次没有「获得物品」弹窗也不该失败，回循环接着判体力。
        "on_error": ["刷体力-回循环"]
    },
    "刷体力-获得物品": {
        // 每轮扫荡正常用一次；给足余量，超了说明卡住了，别无限重试。
        "max_hit": 40,
        "recognition": "TemplateMatch",
        "roi": [
            175,
            295,
            380,
            160
        ],
        "template": ["刷体力/刷体力-获得物品_1.png"],
        "threshold": 0.7,
        // 点底部「触·摸·继·续」的位置。绝对不能点物品卡片区——
        // 卡片会吃掉点击只弹个物品名提示（5 个物品两行时连左上角都是卡片）。
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    362,
                    843
                ]
            }
        },
        "post_delay": 1500,
        "timeout": 30000,
        "next": ["刷体力-回循环"]
    },
    // 回循环：扫荡结算完之后统一从这里回到循环。
    // 不能直接写 next=["刷体力-循环"]——最后一次扫荡会把体力打到 16 以下，
    // 那时 `循环`（要求 >=16）永远不命中，节点只能超时失败（full3 就是这么死在最后的，
    // 体力 292→6 已经刷完，却卡在结算后回不去，没能回培育室）。
    "刷体力-回循环": {
        "recognition": "DirectHit",
        "timeout": 60000,
        "next": [
            "刷体力-循环",
            "刷体力-体力不足",
            "刷体力-体力读不到"
        ],
        // 三种体力状态都判不出来 → 保守回家。
        "on_error": ["刷体力-回家"]
    },
    "刷体力-体力不足": {
        "recognition": "OCR",
        "roi": [
            338,
            5,
            120,
            32
        ],
        // 当前体力 <= 15：不够再扫一次，收工回家。
        "expected": "^(0|[1-9]|1[0-5])/",
        "threshold": 0.3,
        "action": "DoNothing",
        "timeout": 60000,
        "next": ["刷体力-回家"]
    },

    // ------------------------------------------------------------------
    // 回家：从任何界面走回培育室。
    // ------------------------------------------------------------------
    "刷体力-回家": {
        "recognition": "DirectHit",
        "timeout": 180000,
        "next": [
            "刷体力-到家",
            "刷体力-回家-主界面",
            "刷体力-回家-城市地图",
            "刷体力-回家-探险地图",
            "刷体力-回家-关卡",
            "刷体力-回家-世界地图"
